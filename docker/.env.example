VIRUSTOTAL_API_KEY=

# Token de administrador — requerido para acceder a /api/*
# Genera uno seguro con: openssl rand -hex 32
ADMIN_TOKEN=

# API keys de clientes separadas por coma (opcional, se pueden crear desde el dashboard)
CLIENT_API_KEYS=

# Activar modo demo con datos de ejemplo (NO usar en producción)
DEMO_MODE=false
